# URL de conexion a PostgreSQL (Neon)
# Formato tipico Neon: postgresql://<user>:<password>@<host-neon>/<db>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# SSL de PostgreSQL
# DB_SSL: true|false (si no se define, se activa automaticamente en Neon/Supabase o en produccion)
# DB_SSL_REJECT_UNAUTHORIZED: true|false (en proveedores gestionados suele usarse false)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Entorno (development | production)
NODE_ENV=development

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000

# URL publica de la aplicacion para construir enlaces de verificacion.
# En local puede ser http://localhost:3000
APP_URL=https://cqbfactory.com

# Opcional: fuerza dominio/protocolo canonico en produccion.
# Si no se define, se toma desde APP_URL.
# CANONICAL_HOST=cqbfactory.com
# CANONICAL_PROTOCOL=https

# Configuracion SMTP para envio automatico del correo de verificacion con Brevo
# Crea tus credenciales SMTP en Brevo y verifica el remitente antes de enviar.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
# En Brevo, SMTP_USER suele ser el login SMTP entregado por la plataforma.
SMTP_USER=tu-login-smtp-brevo
SMTP_PASS=tu-clave-smtp-brevo
MAIL_FROM="CQB Factory <no-reply@tu-dominio.com>"
