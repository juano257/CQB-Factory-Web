# URL de conexion a PostgreSQL (Neon)
# Formato tipico Neon: postgresql://<user>:<password>@<host-neon>/<db>?sslmode=require
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-name-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# SSL de PostgreSQL
# DB_SSL: true|false (si no se define, se activa automaticamente en Neon/Supabase o en produccion)
# DB_SSL_REJECT_UNAUTHORIZED: true|false (en proveedores gestionados suele usarse false)
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Entorno (development | production)
NODE_ENV=development

# Puerto del servidor (opcional, por defecto 3000)
PORT=3000
